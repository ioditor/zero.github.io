      "elements": [
        {
          "id": "guide-3549",
          "type": "text",
          "x": 8,
          "y": 13,
          "width": 81,
          "rotation": 0,
          "text": "03 / ПИСЬМО",
          "fontSize": 8.2,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3550",
          "type": "text",
          "x": 8,
          "y": 26,
          "width": 81,
          "rotation": 0,
          "text": "Мысль на месте",
          "fontSize": 21,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3551",
          "type": "text",
          "x": 8,
          "y": 49,
          "width": 84,
          "rotation": 0,
          "text": "Текст не привязан к одному потоку. Начните в любом месте листа, перемещайте фрагменты и меняйте направление письма.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3552",
          "type": "text",
          "x": 8,
          "y": 88,
          "width": 84,
          "rotation": 0,
          "text": "Буквы в пространстве",
          "fontSize": 16,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3553",
          "type": "text",
          "x": 8,
          "y": 101,
          "width": 84,
          "rotation": 0,
          "text": "Преобразуйте текст в пространственный: двигайте и поворачивайте отдельные буквы. Слова становятся частью композиции.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3554",
          "type": "text",
          "x": 8,
          "y": 142,
          "width": 81,
          "rotation": 0,
          "text": "Still",
          "fontSize": 20,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3555",
          "type": "text",
          "x": 8,
          "y": 154,
          "width": 84,
          "rotation": 0,
          "text": "Спокойный основной текст.",
          "fontSize": 9.5,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
