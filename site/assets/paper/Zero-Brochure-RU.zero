          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3561",
          "type": "text",
          "x": 108,
          "y": 26,
          "width": 81,
          "rotation": 0,
          "text": "Линия от руки",
          "fontSize": 21,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3562",
          "type": "text",
          "x": 108,
          "y": 49,
          "width": 84,
          "rotation": 0,
          "text": "Перо, карандаш и линер помогают думать рисунком: от быстрого контура до аккуратной схемы.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
