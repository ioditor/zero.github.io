      "elements": [
        {
          "id": "guide-1",
          "type": "text",
          "x": 8,
          "y": 13,
          "width": 81,
          "rotation": 0,
          "text": "01 / ПЕРВЫЕ ШАГИ",
          "fontSize": 8.2,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-2",
          "type": "text",
          "x": 8,
          "y": 26,
          "width": 81,
          "rotation": 0,
          "text": "Начните с листа",
          "fontSize": 21,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3",
          "type": "text",
          "x": 8,
          "y": 51,
          "width": 10,
          "rotation": 0,
          "text": "01",
          "fontSize": 9,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-4",
          "type": "text",
          "x": 21,
          "y": 50,
          "width": 68,
          "rotation": 0,
          "text": "Щёлкните на бумаге и начните писать. Текст появляется там, где нужна мысль.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-5",
          "type": "text",
          "x": 8,
          "y": 83,
          "width": 10,
          "rotation": 0,
          "text": "02",
          "fontSize": 9,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-6",
          "type": "text",
          "x": 21,
          "y": 82,
          "width": 68,
          "rotation": 0,
          "text": "Выберите перо для наброска. Выделите текст и добавьте цветной маркер.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-7",
          "type": "text",
          "x": 8,
          "y": 115,
          "width": 10,
          "rotation": 0,
          "text": "03",
          "fontSize": 9,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-8",
          "type": "text",
          "x": 21,
          "y": 114,
          "width": 68,
          "rotation": 0,
          "text": "Откройте Стол: разложите страницы, соберите стопку и соедините идеи.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-9",
          "type": "text",
          "x": 8,
          "y": 153,
          "width": 81,
          "rotation": 0,
          "text": "Шаблоны",
          "fontSize": 16,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-10",
          "type": "text",
          "x": 8,
          "y": 166,
          "width": 81,
          "rotation": 0,
          "text": "Начните с заметок, наброска, карты мыслей или стопки проекта. Откройте шаблон и сохраните свою копию.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-11",
          "type": "text",
          "x": 105,
          "y": 13,
          "width": 81,
          "rotation": 0,
          "text": "02 / С СОБОЙ",
          "fontSize": 8.2,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-12",
          "type": "text",
          "x": 105,
          "y": 26,
          "width": 81,
          "rotation": 0,
          "text": "Бумажный Zero",
          "fontSize": 21,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-13",
          "type": "text",
          "x": 105,
          "y": 49,
          "width": 81,
          "rotation": 0,
          "text": "Один лист. Шесть панелей.\nНебольшой путеводитель, который можно положить рядом с клавиатурой.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-14",
          "type": "text",
          "x": 105,
          "y": 82,
          "width": 81,
          "rotation": 0,
          "text": "Скачать Zero",
          "fontSize": 16,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3535",
          "type": "text",
          "x": 139,
          "y": 107,
          "width": 47,
          "rotation": 0,
          "text": "ioditor.github.io/\nzero.github.io/",
          "fontSize": 8.8,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3536",
          "type": "text",
          "x": 105,
          "y": 135,
          "width": 81,
          "rotation": 0,
          "text": "Адрес проекта Zero.",
          "fontSize": 9.2,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3537",
          "type": "text",
          "x": 105,
          "y": 153,
          "width": 81,
          "rotation": 0,
          "text": "Печать и складывание",
          "fontSize": 14,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3538",
          "type": "text",
          "x": 105,
          "y": 166,
          "width": 81,
          "rotation": 0,
          "text": "A4, 100%, две стороны. Переворот по короткому краю. Внутренняя сторона вверх: сначала правый узкий клапан влево, затем левую панель вправо.",
          "fontSize": 9.6,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3539",
          "type": "text",
          "x": 205,
          "y": 20,
          "width": 83,
          "rotation": 0,
          "text": "ZERO",
          "fontSize": 49,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3540",
          "type": "text",
          "x": 205,
          "y": 53,
          "width": 83,
          "rotation": 0,
          "text": "Цифровая\nбумага.",
          "fontSize": 28,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3541",
          "type": "text",
          "x": 205,
          "y": 91,
          "width": 81,
          "rotation": 0,
          "text": "Пишите где угодно.\nРисуйте свободно.\nСоединяйте идеи.",
          "fontSize": 12,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
