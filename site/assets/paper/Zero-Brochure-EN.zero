          "x": 105,
          "y": 135,
          "width": 81,
          "rotation": 0,
          "text": "Zero project address.",
          "fontSize": 9.2,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-7132",
          "type": "text",
          "x": 105,
          "y": 153,
          "width": 81,
          "rotation": 0,
          "text": "Print and fold",
          "fontSize": 14,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-7133",
          "type": "text",
          "x": 105,
          "y": 166,
          "width": 81,
          "rotation": 0,
          "text": "A4, 100%, both sides. Flip on the short edge. Inside face up: fold the narrow right flap left, then the left panel right.",
          "fontSize": 9.6,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-7134",
