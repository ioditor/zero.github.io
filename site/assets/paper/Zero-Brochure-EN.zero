          "y": 51,
          "width": 10,
          "rotation": 0,
          "text": "01",
          "fontSize": 9,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3599",
          "type": "text",
          "x": 21,
          "y": 50,
          "width": 68,
          "rotation": 0,
          "text": "Click the paper and start typing. Put a thought exactly where you need it.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3600",
          "type": "text",
          "x": 8,
          "y": 83,
          "width": 10,
          "rotation": 0,
          "text": "02",
          "fontSize": 9,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3601",
          "type": "text",
          "x": 21,
          "y": 82,
          "width": 68,
          "rotation": 0,
          "text": "Choose a pen for a sketch. Select text and add a coloured marker.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3602",
          "type": "text",
          "x": 8,
          "y": 115,
          "width": 10,
          "rotation": 0,
          "text": "03",
          "fontSize": 9,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3603",
          "type": "text",
          "x": 21,
          "y": 114,
          "width": 68,
          "rotation": 0,
          "text": "Open Desk: arrange pages, collect a stack and connect ideas.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3604",
          "type": "text",
          "x": 8,
          "y": 153,
          "width": 81,
          "rotation": 0,
          "text": "Templates",
          "fontSize": 16,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3605",
          "type": "text",
          "x": 8,
          "y": 166,
          "width": 81,
          "rotation": 0,
          "text": "Begin with notes, a sketch, a mind map or a project stack. Open a template and save your own copy.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3606",
          "type": "text",
          "x": 105,
          "y": 13,
          "width": 81,
          "rotation": 0,
          "text": "02 / TAKE IT WITH YOU",
          "fontSize": 8.2,
          "fontId": "mono",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3607",
          "type": "text",
          "x": 105,
          "y": 26,
          "width": 81,
          "rotation": 0,
          "text": "Zero on Paper",
          "fontSize": 21,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3608",
          "type": "text",
          "x": 105,
          "y": 49,
          "width": 81,
          "rotation": 0,
          "text": "One sheet. Six panels.\nA small guide to keep beside your keyboard.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-3609",
          "type": "text",
          "x": 105,
          "y": 82,
          "width": 81,
          "rotation": 0,
          "text": "Get Zero",
          "fontSize": 16,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
