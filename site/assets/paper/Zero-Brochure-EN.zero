        },
        {
          "id": "guide-7145",
          "type": "text",
          "x": 8,
          "y": 26,
          "width": 81,
          "rotation": 0,
          "text": "A thought in place",
          "fontSize": 21,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-7146",
          "type": "text",
          "x": 8,
          "y": 49,
          "width": 84,
          "rotation": 0,
          "text": "Text is free from a single flow. Start anywhere on the sheet, move fragments and change the direction of writing.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-7147",
          "type": "text",
          "x": 8,
          "y": 88,
          "width": 84,
          "rotation": 0,
          "text": "Letters in space",
          "fontSize": 16,
          "fontId": "flow",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
        {
          "id": "guide-7148",
          "type": "text",
          "x": 8,
          "y": 101,
          "width": 84,
          "rotation": 0,
          "text": "Convert text to spatial text: move and rotate individual letters. Words become part of the composition.",
          "fontSize": 10.8,
          "fontId": "still",
          "lineHeight": 1.4,
          "color": "ink",
          "zIndex": 0
        },
